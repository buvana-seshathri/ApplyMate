# Local model settings (Ollama)
# Run `ollama serve` and `ollama pull llama3.1` before starting the backend.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Seconds to wait for a full tailoring response. CPU inference is slow —
# raise this further if you still see timeouts on a large resume/JD.
OLLAMA_TIMEOUT_SECONDS=600
